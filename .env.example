# Copy to .env for local `netlify dev` use; set the real values in the
# Netlify dashboard (Site configuration > Environment variables) for
# deployed environments. Never commit actual secrets.

# Netlify Purge API — lets save-page.js/save-news.js/save-site-settings.js/
# save-banner.js literally invalidate just the affected cached read(s) by
# Cache-Tag on every save (see netlify/functions/utils/purge-cache.js).
# NETLIFY_PURGE_TOKEN is a site-scoped Netlify personal access token
# (create one under User settings > Applications > Personal access tokens,
# scoped to this site). NETLIFY_SITE_ID is optional — Netlify already
# injects SITE_ID automatically at runtime; only set this to override that
# (e.g. for local `netlify dev` against a specific site).
NETLIFY_PURGE_TOKEN=
NETLIFY_SITE_ID=

# GitHub content backup (CLAUDE.md Core Architecture, "Backup"): every page/
# news save re-commits backup/content-backup.csv to the site's own repo
# (netlify/functions/utils/github-backup.js). Best-effort — if these are
# unset or GitHub is down, saves still succeed and an alert is logged.
# GITHUB_BACKUP_TOKEN: a fine-grained personal access token limited to the
# ONE repo below, with only "Contents: Read and write" permission.
# The other three are optional; these are the defaults.
# Commits go to a separate branch so they don't trigger a production
# deploy or collide with normal pushes to main.
GITHUB_BACKUP_TOKEN=
# GITHUB_BACKUP_REPO=Barnaskoli-Karsness-skoli/barnaskolikarsness
# GITHUB_BACKUP_BRANCH=content-backup
# GITHUB_BACKUP_PATH=backup/content-backup.csv

# TODO: no transactional email provider has been chosen yet for the
# backup-failure alert (see netlify/functions/utils/email-alert.js).
# Add its API key here once one is picked, e.g.:
# EMAIL_PROVIDER_API_KEY=

# Netlify Identity itself needs no env var here — Netlify verifies the
# caller's JWT and exposes it as context.clientContext.user automatically.

# Standalone local scripts only (scripts/seed-content.js,
# scripts/rebuild-search-index.js) — not a Function. Both write/read Blobs
# outside any Function/Identity context, so they need their own token
# rather than reusing NETLIFY_PURGE_TOKEN (that one is purge-scoped only).
# Create a personal access token under User settings > Applications >
# Personal access tokens. Run: `npm run seed` / `npm run rebuild-search-index`.
NETLIFY_AUTH_TOKEN=
